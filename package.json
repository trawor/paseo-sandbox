{
  "name": "@trawor/paseo-sandbox",
  "version": "0.4.0-fork.1",
  "type": "module",
  "description": "Run a project's Paseo workspaces, agents and terminals inside an isolated sandbox, with a per-project runtime image (.paseo.Dockerfile / .paseo/sandbox.json). Fork of @omercnet/paseo-sandbox.",
  "license": "MIT",
  "author": "Omer Cohen (original); fork by Travis Wang",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "sandbox",
    "docker",
    "isolation",
    "coding-agents"
  ],
  "files": [
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "runtime",
    "paseo-plugin.json",
    "icon.png",
    "OVERVIEW.md",
    "examples"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "embed:dockerfile": "node scripts/embed-dockerfile.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "npm pack --dry-run",
    "test:e2e:local": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@getpaseo/plugin": "0.14.0",
    "@getpaseo/protocol": "0.14.0",
    "@tanstack/react-query": "^5.102.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "4.4.3"
  },
  "private": true
}
